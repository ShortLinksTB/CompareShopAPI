FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["CompareShopAPI.Workers/CompareShopAPI.Workers.csproj", "CompareShopAPI.Workers/"]
COPY ["CompareShopAPI.Application/CompareShopAPI.Application.csproj", "CompareShopAPI.Application/"]
COPY ["CompareShopAPI.Domain/CompareShopAPI.Domain.csproj", "CompareShopAPI.Domain/"]
COPY ["CompareShopAPI.Infrastructure/CompareShopAPI.Infrastructure.csproj", "CompareShopAPI.Infrastructure/"]
RUN dotnet restore "CompareShopAPI.Workers/CompareShopAPI.Workers.csproj"
COPY . .
RUN dotnet publish "CompareShopAPI.Workers/CompareShopAPI.Workers.csproj" -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0-noble AS runtime
WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright DOTNET_EnableDiagnostics=0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget libnss3 libatk1.0-0 libatk-bridge2.0-0 libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 libgbm1 libgtk-3-0 libasound2t64 libdrm2 libxkbcommon0 libatspi2.0-0 \
    && wget -q https://packages.microsoft.com/config/ubuntu/24.04/packages-microsoft-prod.deb -O /tmp/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb && apt-get update && apt-get install -y --no-install-recommends powershell \
    && rm -rf /var/lib/apt/lists/* /tmp/packages-microsoft-prod.deb
COPY --from=build /app/publish .
RUN pwsh ./playwright.ps1 install chromium
USER app
ENTRYPOINT ["dotnet", "CompareShopAPI.Workers.dll"]
